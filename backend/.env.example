# Copy to .env locally, or paste into Railway → Variables

DEBUG=False
ALLOWED_HOSTS=*
BASE_DOMAIN=localhost

# --- Frontend connection (REQUIRED on Railway) ---
# Your Vercel site URL (no trailing slash)
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

# Optional: multiple frontends, comma-separated
# FRONTEND_URLS=https://app1.vercel.app,https://app2.vercel.app

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-FRONTEND.vercel.app,https://multi-tenant-production-a3db.up.railway.app

# Database: Railway Postgres usually provides DATABASE_URL / PG* automatically
# DATABASE_URL=
# DATABASE_PUBLIC_URL=

# Optional AI
# GROQ_API_KEY=
