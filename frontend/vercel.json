{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://multi-tenant-production-a3db.up.railway.app/api/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "https://multi-tenant-production-a3db.up.railway.app/media/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
