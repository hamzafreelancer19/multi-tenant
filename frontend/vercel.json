{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://multi-tenant-production-a3db.up.railway.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://multi-tenant-production-a3db.up.railway.app/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
